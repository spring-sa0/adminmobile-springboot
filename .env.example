# Copie ce fichier en .env puis renseigne les vraies valeurs.
# .env est deja exclu du depot via .gitignore.

# Base de donnees Oracle (obligatoire)
DB_URL=jdbc:oracle:thin:@//host-oracle:1521/SERVICE_NAME
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=16

# Serveur
SERVER_PORT=8080
THYMELEAF_CACHE=true

# Blocage temporaire apres echecs de connexion (optionnel, valeurs par defaut ci-dessous)
MAX_LOGIN_ATTEMPTS=2
MAX_LOGIN_ATTEMPTS_PER_IP=50
LOGIN_LOCK_DURATION=15m

# Mail (parametrage des releves, notifications)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse expeditrice (optionnel ; defaut : MAIL_USERNAME s'il s'agit d'une adresse, sinon sms.contact@laposte.tg)
MAIL_FROM=
# Chiffrement STARTTLS (obligatoire sur le port 587) et authentification SMTP (optionnels, true par defaut)
MAIL_STARTTLS=true
MAIL_AUTH=true

# Recherches (optionnel) : periode maximale en jours, lignes par page
RECHERCHE_PERIODE_MAX_JOURS=92
RECHERCHE_TAILLE_PAGE=100

# Dossier des journaux adminmobile.log / audit.log (optionnel ; /app/logs dans Docker)
# LOG_DIR=logs

# Export Excel / PDF des listes (optionnel) : nombre maximal de lignes par fichier
EXPORT_MAX_LIGNES_EXCEL=50000
EXPORT_MAX_LIGNES_PDF=5000

# Montee en charge (optionnel) : recherches / exports lourds simultanes, attente d'une place (s)
CHARGE_TRAITEMENTS_LOURDS=8
CHARGE_ATTENTE_SECONDES=20

# Supervision (/supervision) : alertes par e-mail (base injoignable, mot de passe Oracle expire,
# memoire / pool satures, nouvelle erreur grave...). Necessite MAIL_* ci-dessus.
SUPERVISION_ALERTES_EMAILS=
SUPERVISION_URL=
SUPERVISION_ALERTES_REPETITION=1h
