# Copie ce fichier en .env puis renseigne les vraies valeurs.
# .env est deja exclu du depot via .gitignore.

# Base de donnees Oracle (obligatoire)
DB_URL=jdbc:oracle:thin:@//host-oracle:1521/SERVICE_NAME
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=16

# Serveur
SERVER_PORT=8080
THYMELEAF_CACHE=true

# Blocage temporaire apres echecs de connexion (optionnel, valeurs par defaut ci-dessous)
MAX_LOGIN_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS_PER_IP=20
LOGIN_LOCK_DURATION=15m

# Mail (parametrage des releves, notifications)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Recherches (optionnel) : periode maximale en jours, lignes par page
RECHERCHE_PERIODE_MAX_JOURS=92
RECHERCHE_TAILLE_PAGE=100

# Dossier des journaux adminmobile.log / audit.log (optionnel ; /app/logs dans Docker)
# LOG_DIR=logs

# Export Excel / PDF des listes (optionnel) : nombre maximal de lignes par fichier
EXPORT_MAX_LIGNES_EXCEL=50000
EXPORT_MAX_LIGNES_PDF=5000
