	<queryString>
		<![CDATA[select numero_compte, libelle_mvt,montant_debit,date_valeur,sens,montant_credit,libelle_bureau,
date_valide,solde_prec,sens_prec,nouvo_solde,
sens_nouvo,date_prec,date_solde,date_creation,

(CASE WHEN rtrim(sens_prec) = 'D' THEN solde_prec
ELSE null END) solde_prec_d,
(CASE WHEN rtrim(sens_prec) = 'C' THEN solde_prec
ELSE null END) solde_prec_c,

(CASE WHEN rtrim(sens_nouvo) = 'D' THEN nouvo_solde
ELSE null END) nouvo_solde_d,
(CASE WHEN rtrim(sens_nouvo) = 'C' THEN nouvo_solde
ELSE null END) nouvo_solde_c, solde_apres_op

from imobile.mouvement
order by date_creation asc]]>
	</queryString>
