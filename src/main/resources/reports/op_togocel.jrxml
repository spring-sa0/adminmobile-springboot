	<parameter name="datedebut" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="datefin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select to_char(r.DATE_OPERATION,'yyyy-MM-dd HH24:MI:SS') partner_op_date, r.REFBANK partner_mb_ref,
r.NUMERO_OPERATION partner_bank_ref,
(case  when  r.code_operation in (23015,24042,25043) then 'bankcashin'
       when  r.code_operation in (23010,24043,25042) then 'bankcashout'
 end) partner_op_type,
r.MONTANT partner_amount, r.TELEPHONE partner_initiator_msisdn,
r.NUMERO_COMPTE partner_account_number,
(case  substr(r.numero_compte,-4,1) when  '1' then  'COMPTE COURANT' when '6' then 'COMPTE EPARGNE' ELSE 'AUTRES' end)  partner_account_name,

(case  when  r.code_operation in (23015,24042,25043) then 'bankcashin'
       when  r.code_operation in (23010,24043,25042) then 'bankcashout'
 end) typeop,
cl.nom_client partner_clt_lastname,
cl.prenom_client partner_clt_firstname,
'LA POSTE' partner_bank_name,

(case
       when  r.code_operation in (23010) then 'null' ELSE NUMERO_DEST
 end) partner_dest_msisdn,

(case
       when  r.REFBANK is null then 'ECHEC' ELSE 'SUCCES'
 end) partner_trans_state,

'null' partner_agency_name,
r.COM_OPERATION partner_bank_fees,
r.NUMERO_OPERATION partner_requestid,(case when  r.code_operation in (24042,25042,24043,25043) then 'EPOSTE' else 'ECOCPP'
  end) SOURCE
from
spt.recu_electronique r, spt.client cl
where
substr(r.numero_compte,1,9) = cl.numero_client
and
r.code_operation in (24042,24043,23010,23015)
and
r.MONTANT > 0
and
to_number(to_char(date_operation,'yyyymmdd')) between  to_number(to_char($P{datedebut},'yyyymmdd')) and to_number(to_char($P{datefin},'yyyymmdd'))
order by r.numero_operation]]>
	</queryString>
