	<parameter name="numcompte" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Releve\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select date_mvt date_op,libelle_mvt operation, ag.libelle bureau, date_valeur date_val,
sens,
(CASE SENS WHEN 'D' THEN MONTANT_MVT
ELSE null END) mt_d,

(CASE SENS WHEN 'C' THEN MONTANT_MVT
ELSE null END) mt_c,
ltrim(rtrim(nom_client))||'  '||ltrim(rtrim(prenom_client)) nom_prenom, cl.adresse, cl.telephone,
substr(c.rip,1,5) banque,substr(c.rip,6,5) agence,substr(c.rip,11,12) num_cpt,substr(c.rip,23,24) cle_rip

from spt.mouvement mv, spt.compte c, spt.client cl , spt.agence ag
where
mv.numero_compte = c.numero_compte
and
(cl.code_client = c.numero_client or  cl.numero_client = c.numero_client)
and
ag.code_agence = mv.code_bureau
and
mv.numero_compte = $P{numcompte}
and
to_number(to_char(date_mvt,'yyyymmdd')) between to_number(to_char(ADD_MONTHS(sysdate, -1),'yyyymmdd'))
and
to_number(to_char(sysdate,'yyyymmdd'))

order by date_mvt desc]]>
	</queryString>
	<field name="DATE_OP" class="java.sql.Timestamp"/>
	<field name="OPERATION" class="java.lang.String"/>
	<field name="BUREAU" class="java.lang.String"/>
	<field name="DATE_VAL" class="java.sql.Timestamp"/>
	<field name="SENS" class="java.lang.String"/>
	<field name="MT_D" class="java.math.BigDecimal"/>
	<field name="MT_C" class="java.math.BigDecimal"/>
	<field name="NOM_PRENOM" class="java.lang.String"/>
	<field name="ADRESSE" class="java.lang.String"/>
	<field name="TELEPHONE" class="java.lang.String"/>
	<field name="BANQUE" class="java.lang.String"/>
	<field name="AGENCE" class="java.lang.String"/>
	<field name="NUM_CPT" class="java.lang.String"/>
	<field name="CLE_RIP" class="java.lang.String"/>
	<variable name="MT_D_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MT_D}]]></variableExpression>
	</variable>
	<variable name="MT_C_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MT_C}]]></variableExpression>
	</variable>
