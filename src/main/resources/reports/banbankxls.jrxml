	<style name="Detail" fontName="Arial" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="datedebut" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="datefin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select mv.numero_compte "NUMERO COMPTE", montant_mvt "MONTANT",'228'||cl.telephone "TELEPHONE", r.NUMERO_DEST "BENEFICIAIRE",
(case mv.code_operation
when  23052 then 'ECO-T'
when  23048 then 'ECO-ECO'
when  23054 then 'T-ECO'
when  23050 then 'ECO-BT'
 end) typeop,  date_mvt "DATE OPERATION", mv.code_operation,r.numero_operation, c.intitule
from spt.mouvement mv, spt.compte c, spt.client cl, spt.recu_electronique r
where
mv.numero_compte = c.numero_compte
and
c.numero_client = cl.numero_client
and
r.numero_operation = mv.numero_operation
and
mv.numero_compte like '990%'
and
mv.code_operation in (23048,23052,23054,23050,23154)
and to_number(to_char(mv.date_creation,'yyyymmdd')) between to_number(to_char($P{datedebut},'yyyymmdd')) and to_number(to_char($P{datefin},'yyyymmdd'))
and
montant_mvt > 0
and sens = 'D'
order by mv.date_creation asc]]>
	</queryString>
	<field name="NUMERO COMPTE" class="java.math.BigDecimal"/>
	<field name="MONTANT" class="java.math.BigDecimal"/>
	<field name="TELEPHONE" class="java.lang.String"/>
	<field name="BENEFICIAIRE" class="java.lang.String"/>
	<field name="TYPEOP" class="java.lang.String"/>
	<field name="DATE OPERATION" class="java.sql.Timestamp"/>
	<field name="CODE_OPERATION" class="java.math.BigDecimal"/>
	<field name="NUMERO_OPERATION" class="java.math.BigDecimal"/>
	<field name="INTITULE" class="java.lang.String"/>
	<variable name="NUMERO COMPTE_1" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{NUMERO COMPTE}]]></variableExpression>
	</variable>
	<variable name="MONTANT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTANT}]]></variableExpression>
	</variable>
